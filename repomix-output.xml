// ============================================================
// _inbox.scss — Inbox page (3-column panel layout)
// ============================================================
@use 'variables' as *;
@use 'mixins'    as *;

// ── Inbox container ──────────────────────────────────────────
// Mobile: stacked full-screen panel views (tab-controlled)
// Tablet: 2-column (list + thread)
// Desktop: 3-column (filters | list | thread)
.inbox-layout {
  display: flex;
  flex-direction: column;
  gap: clamp(0.75rem, 2vw, 1rem);
  height: calc(100dvh - 180px); // remaining after topbar + page header
  min-height: 400px;

  @include md {
    flex-direction: row;
    height: calc(100dvh - 160px);
  }

  @include lg {
    height: calc(100dvh - 140px);
  }
}

// ── Filters panel ────────────────────────────────────────────
.inbox-filters {
  @include card(1rem);
  @include scrollable;
  flex-shrink: 0;

  // Mobile: horizontal scrolling tab strip
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  overflow-x: auto;
  overflow-y: hidden;
  gap: 0.5rem;
  padding: 0.75rem;
  height: auto;

  @include touch-device {
    scrollbar-width: none;
    &::-webkit-scrollbar { display: none; }
  }

  @include md {
    flex-direction: column;
    width: 200px;
    height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 1rem;
    gap: 1.25rem;
  }

  @include lg {
    width: 220px;
  }

  &__section-title {
    font-size: $text-xs;
    font-weight: 600;
    color: $slate-400;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0 0.5rem;
    white-space: nowrap;

    // Hide labels on mobile (horizontal strip)
    @include max-md { display: none; }
  }

  &__all-btn {
    @include flex-between;
    padding: 0.625rem 1rem;
    border-radius: $radius-lg;
    font-weight: 500;
    font-size: $text-sm;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: background $transition-base, color $transition-base;
    min-height: 40px;
    white-space: nowrap;
    color: $slate-700;

    &.active {
      background: $indigo-50;
      color: $indigo-700;
    }

    @include hover-device {
      &:not(.active):hover { background: $slate-50; }
    }
  }

  &__filter-btn {
    @include flex-start(0.625rem);
    padding: 0.5rem 0.875rem;
    border-radius: $radius-lg;
    font-weight: 500;
    font-size: $text-sm;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: background $transition-base, color $transition-base;
    min-height: 40px;
    white-space: nowrap;
    color: $slate-600;

    &.active {
      background: $indigo-50;
      color: $indigo-700;
    }

    @include hover-device {
      &:not(.active):hover { background: $slate-50; }
    }
  }

  &__unread-badge {
    margin-left: auto;
    padding: 0.125rem 0.5rem;
    border-radius: $radius-full;
    background: $red-500;
    color: $white;
    font-size: 0.65rem;
    font-weight: 700;
    min-width: 1.25rem;
    text-align: center;
  }

  &__divider {
    @include max-md { display: none; }
    border: none;
    border-top: 1px solid $slate-100;
    margin: 0;
  }
}

// ── Messages list panel ──────────────────────────────────────
.inbox-list {
  @include card(0);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex: 1;
  min-height: 300px;

  @include md {
    width: 260px;
    flex: none;
    height: 100%;
  }

  @include lg { width: 300px; }

  &__header {
    @include flex-between;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid $slate-100;
    flex-shrink: 0;

    &-count {
      font-weight: 600;
      color: $slate-700;
      font-size: $text-sm;
    }
  }

  &__scroll {
    flex: 1;
    @include scrollable;
  }

  &__empty {
    @include flex-center;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    min-height: 200px;
    color: $slate-400;
    font-size: $text-sm;
  }
}

// ── Message item ─────────────────────────────────────────────
.message-item {
  display: flex;
  gap: 0.75rem;
  padding: 0.875rem 1rem;
  border-bottom: 1px solid $slate-100;
  cursor: pointer;
  transition: background $transition-fast;
  position: relative;

  &.unread {
    border-left: 3px solid $blue-500;
    padding-left: calc(1rem - 3px);
  }

  &.selected { background: $indigo-50; }

  @include hover-device {
    &:not(.selected):hover { background: $slate-50; }
  }

  &__avatar-wrap {
    position: relative;
    flex-shrink: 0;

    img {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: $radius-full;
      object-fit: cover;
    }
  }

  &__platform-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
  }

  &__content {
    flex: 1;
    min-width: 0;
  }

  &__header-row {
    @include flex-between;
    margin-bottom: 0.2rem;
  }

  &__sender {
    font-size: $text-sm;
    font-weight: 500;
    color: $slate-700;
    @include truncate;

    &.unread {
      font-weight: 700;
      color: $slate-900;
    }
  }

  &__time {
    font-size: $text-xs;
    color: $slate-400;
    white-space: nowrap;
    margin-left: 0.5rem;
  }

  &__preview {
    font-size: $text-sm;
    color: $slate-500;
    @include truncate;
    margin-bottom: 0.25rem;
  }

  &__tags {
    @include flex-start(0.375rem);
  }

  &__type-tag {
    font-size: 0.65rem;
    padding: 0.1rem 0.4rem;
    border-radius: $radius-full;
    background: $slate-100;
    color: $slate-500;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
}

// ── Thread panel ─────────────────────────────────────────────
.inbox-thread {
  @include card(0);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex: 1;

  @include md { height: 100%; }

  // Empty state
  &__empty {
    @include flex-center;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    min-height: 200px;
    color: $slate-400;

    &-title {
      font-size: $text-base;
      font-weight: 600;
    }
  }

  &__header {
    @include flex-between;
    padding: clamp(0.875rem, 2vw, 1.25rem);
    border-bottom: 1px solid $slate-100;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  &__sender {
    @include flex-start(0.875rem);

    img {
      width: 3rem;
      height: 3rem;
      border-radius: $radius-full;
      object-fit: cover;
      flex-shrink: 0;
    }
  }

  &__name {
    font-weight: 700;
    color: $slate-900;
    margin: 0;
    font-size: $text-base;
  }

  &__handle {
    font-size: $text-sm;
    color: $slate-500;
    margin: 0.125rem 0 0;
  }

  &__body {
    flex: 1;
    @include scrollable;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  &__post-preview {
    padding: 0.875rem 1rem;
    border-radius: $radius-lg;
    background: $slate-100;
    margin-bottom: 1rem;

    &-label {
      font-size: $text-xs;
      color: $slate-500;
      margin: 0 0 0.25rem;
    }

    &-text {
      font-size: $text-sm;
      color: $slate-700;
      margin: 0;
    }
  }

  &__message-text {
    color: $slate-700;
    line-height: 1.65;
    font-size: $text-base;
    margin: 0 0 0.75rem;
  }

  &__time {
    font-size: $text-sm;
    color: $slate-400;
  }

  &__reply-sent {
    margin-top: 1.5rem;
    padding: 0.875rem 1rem;
    border-radius: $radius-lg;
    background: $green-50;
    border: 1px solid $green-100;

    &-label {
      font-size: $text-xs;
      color: $green-600;
      font-weight: 600;
      margin: 0 0 0.375rem;
    }

    &-text {
      font-size: $text-sm;
      color: #166534;
      margin: 0;
    }
  }

  // Reply composer
  &__composer {
    padding: clamp(0.75rem, 2vw, 1rem);
    border-top: 1px solid $slate-100;
    flex-shrink: 0;

    textarea {
      @include input-base;
      height: auto;
      min-height: 80px;
      padding: 0.75rem 1rem;
      border-radius: $radius-lg;
      resize: none;
    }
  }

  &__composer-footer {
    @include flex-between;
    margin-top: 0.625rem;

    &-count {
      font-size: $text-xs;
      color: $slate-400;
    }
  }
}

// Mobile: show only one panel at a time with tab navigation
.inbox-mobile-tabs {
  display: flex;
  gap: 0;
  background: $slate-100;
  border-radius: $radius-lg;
  padding: 0.25rem;
  margin-bottom: 0.75rem;

  @include md { display: none; }

  &__tab {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border-radius: $radius-md;
    font-size: $text-xs;
    font-weight: 600;
    border: none;
    background: transparent;
    color: $slate-600;
    cursor: pointer;
    text-align: center;
    transition: background $transition-base, color $transition-base;
    min-height: 36px;

    &.active {
      background: $white;
      box-shadow: $shadow-sm;
      color: $indigo-600;
    }
  }
}
