          return (
            <motion.div
              key={`empty-${platform.platform}`}
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.05 * index }}
            >
              <PlatformCard
                platform={platform.platform}
                connected={false}
                account={null} 
                oauthSupported={platform.oauthSupported}
                onDisconnect={disconnectAccount}
              />
            </motion.div>
          );
        })}
      </motion.div>
    </PageWrapper>
  );
}
