// ============================================================
// _layout.scss — App Shell, Sidebar, Bottom Nav, Page Header
// ============================================================
@use 'variables' as *;
@use 'mixins'    as *;

// ── App Shell ────────────────────────────────────────────────
.app-shell {
  display: flex;
  min-height: 100vh;
  min-height: 100dvh;
  overflow-x: hidden;
  background: #f8fafc;
}

// ── Sidebar ──────────────────────────────────────────────────
.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  height: 100dvh;
  width: $sidebar-width;
  z-index: $z-sidebar;
  transform: translateX(-100%);
  transition: transform $transition-slow, width $transition-slow;
  @include glass(0.92);
  border-right: 1px solid rgba($slate-200, 0.6);
  @include scrollable;
  @include safe-bottom;

  &.open {
    transform: translateX(0);
    box-shadow: $shadow-dropdown;
  }

  // ── Tablet: collapsed icon rail ──────────────────────────
  @include md {
    position: sticky;
    transform: translateX(0);
    width: $sidebar-collapsed-width;
    flex-shrink: 0;
    box-shadow: none;

    &.expanded { width: $sidebar-width; }

    .sidebar__label,
    .sidebar__section-title {
      opacity: 0;
      pointer-events: none;
      width: 0;
      overflow: hidden;
      white-space: nowrap;
      transition: opacity $transition-slow, width $transition-slow;
    }

    &.expanded {
      .sidebar__label,
      .sidebar__section-title {
        opacity: 1;
        pointer-events: auto;
        width: auto;
      }
    }
  }

  // ── Desktop: always full ─────────────────────────────────
  @include lg {
    width: $sidebar-width;

    .sidebar__label,
    .sidebar__section-title {
      opacity: 1;
      pointer-events: auto;
      width: auto;
    }
  }
}

// Sidebar nav items
.sidebar__nav-item {
  @include flex-start(0.75rem);
  padding: 0.625rem 1rem;
  border-radius: $radius-lg;
  font-size: $text-sm;
  font-weight: 500;
  color: $slate-600;
  cursor: pointer;
  transition: background $transition-base, color $transition-base;
  min-height: 44px;
  text-decoration: none;

  &:hover { background: $slate-50; color: $slate-900; }

  &.active {
    background: $indigo-50;
    color: $indigo-600;
    font-weight: 600;
  }

  svg { flex-shrink: 0; }
}

// Mobile overlay backdrop
.sidebar-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba($slate-900, 0.5);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: $z-overlay;
  animation: fadeIn 0.2s ease-out;

  &.active { display: block; }

  @include md { display: none !important; }
}

// ── Mobile Top Bar ───────────────────────────────────────────
.mobile-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: $z-sticky;
  height: 56px;
  padding: 0 1rem;
  @include safe-left;
  @include safe-right;
  @include glass(0.9);
  border-bottom: 1px solid $slate-200;

  @include md { display: none; }

  &__logo {
    @include flex-start(0.625rem);
    font-family: $font-heading;
    font-weight: 700;
    font-size: 1.125rem;
    color: $slate-900;
  }

  &__hamburger {
    @include flex-center;
    width: 44px;
    height: 44px;
    border-radius: $radius-md;
    border: none;
    background: transparent;
    cursor: pointer;
    color: $slate-700;
    transition: background $transition-base;

    &:hover { background: $slate-100; }
  }
}

// ── Main Content ─────────────────────────────────────────────
.main-content {
  flex: 1;
  min-width: 0;
  overflow-x: hidden;
  padding-bottom: calc(#{$bottom-nav-height} + env(safe-area-inset-bottom));

  @include md { padding-bottom: 0; }
}

// ── Page Wrapper ─────────────────────────────────────────────
.page-wrapper {
  padding: $space-sm;

  @include sm  { padding: $space-md; }
  @include lg  { padding: $space-lg; }
}

// ── Page Header ──────────────────────────────────────────────
.page-header {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: clamp(1.5rem, 4vw, 2rem);

  @include sm {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  &__title-group {
    @include flex-start(clamp(0.75rem, 2vw, 1rem));
  }

  &__icon {
    @include page-icon;
  }

  &__title {
    font-family: $font-heading;
    font-size: $text-3xl;
    font-weight: 700;
    color: $slate-900;
    line-height: 1.2;
    margin: 0;
  }

  &__subtitle {
    font-size: $text-sm;
    color: $slate-500;
    margin: 0.125rem 0 0;
  }

  &__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;

    @include max-sm { width: 100%; > * { flex: 1; } }
  }
}

// ── Bottom Navigation (mobile only) ─────────────────────────
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: $z-overlay;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: calc(#{$bottom-nav-height} + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  @include glass(0.95);
  border-top: 1px solid $slate-200;

  @include md { display: none; }

  &__item {
    @include flex-center;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-height: 48px;
    font-size: 0.62rem;
    font-weight: 600;
    color: $slate-400;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    border: none;
    background: transparent;
    transition: color $transition-base;
    text-decoration: none;

    svg { width: 22px; height: 22px; }

    &.active { color: $indigo-500; }
  }
}

// ── Responsive container ────────────────────────────────────
.container-responsive {
  width: 100%;
  padding-left:  clamp(1rem, 4vw, 2rem);
  padding-right: clamp(1rem, 4vw, 2rem);
  margin: 0 auto;
  max-width: 1440px;
}
