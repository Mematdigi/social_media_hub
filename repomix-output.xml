);

// ── Typography ───────────────────────────────────────────────
$font-heading: 'Outfit', sans-serif;
$font-body:    'DM Sans', sans-serif;

// Fluid font sizes using clamp()
$text-xs:   clamp(0.65rem,  1.5vw, 0.75rem);
$text-sm:   clamp(0.8rem,   2vw,   0.875rem);
$text-base: clamp(0.875rem, 2.5vw, 1rem);
