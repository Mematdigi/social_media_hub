// Core Variables for a sleek, modern aesthetic
$bg-color: #0a0a0a;
$text-primary: #f4f4f5;
$text-secondary: #a1a1aa;
$brand-highlight: #ff3366; 
$font-stack: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

.memat-media-app {
  font-family: $font-stack;
  background-color: $bg-color;
  color: $text-primary;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;

  // Reusable Buttons
  .btn-primary, .btn-secondary {
    padding: 12px 28px;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 4px;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary {
    background-color: $text-primary;
    color: $bg-color;
    border: 2px solid $text-primary;
    
    &:hover {
      background-color: $brand-highlight;
      border-color: $brand-highlight;
      color: #fff;
    }
  }

  .btn-secondary {
    background-color: transparent;
    color: $text-primary;
    border: 2px solid rgba(255, 255, 255, 0.2);

    &:hover {
      border-color: $text-primary;
      background-color: rgba(255, 255, 255, 0.05);
    }
  }

  // 1. HEADER
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 5%;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;

    &__logo {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    &__nav {
      display: flex;
      gap: 40px;
      align-items: center;

      a {
        color: $text-primary;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
        transition: color 0.2s ease;
        
        &:not(.btn-primary):hover {
          color: $brand-highlight;
        }
      }

      @media (max-width: 768px) {
        display: none; // Collapse nav on mobile for a hamburger menu later
      }
    }
  }

  // 2. MAIN BODY
  .main-content {
    flex: 1;
  }

  .hero {
    padding: 140px 5%;
    text-align: center;
    max-width: 1000px;
    margin: 0 auto;

    &__title {
      font-size: clamp(3rem, 8vw, 6rem);
      font-weight: 900;
      line-height: 1.05;
      margin-bottom: 24px;
      text-transform: uppercase;
      letter-spacing: -1px;

      .text-highlight {
        color: $brand-highlight;
        font-style: italic;
        display: inline-block;
      }
    }

    &__subtitle {
      font-size: 1.25rem;
      color: $text-secondary;
      margin-bottom: 48px;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    &__actions {
      display: flex;
      gap: 20px;
      justify-content: center;
      
      @media (max-width: 480px) {
        flex-direction: column;
      }
    }
  }

  .featured-brands {
    padding: 100px 5%;
    background-color: #111;

    .section-title {
      font-size: 2rem;
      margin-bottom: 56px;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-weight: 800;
    }

    .brand-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 32px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .brand-card {
      background-color: $bg-color;
      padding: 48px 40px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      transition: transform 0.3s ease, border-color 0.3s ease;

      h3 {
        font-size: 1.75rem;
        margin-bottom: 16px;
        color: $brand-highlight;
        font-weight: 700;
      }

      p {
        color: $text-secondary;
        line-height: 1.7;
        font-size: 1rem;
      }

      &:hover {
        transform: translateY(-8px);
        border-color: rgba(255, 255, 255, 0.2);
      }
    }
  }

  // 3. FOOTER
  .footer {
    padding: 80px 5% 40px;
    background-color: #050505;
    border-top: 1px solid rgba(255, 255, 255, 0.05);

    &__content {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 40px;
      margin-bottom: 64px;
      max-width: 1200px;
      margin-left: auto;
      margin-right: auto;
    }

    &__brand {
      h2 {
        font-size: 1.75rem;
        font-weight: 800;
        margin-bottom: 16px;
        letter-spacing: 1px;
      }
      p {
        color: $text-secondary;
      }
    }

    &__links {
      display: flex;
      flex-direction: column;
      gap: 16px;

      a {
        color: $text-secondary;
        text-decoration: none;
        transition: color 0.2s ease;
        font-weight: 500;

        &:hover {
          color: $text-primary;
        }
      }
    }

    &__bottom {
      text-align: center;
      color: rgba(255, 255, 255, 0.4);
      font-size: 0.875rem;
      padding-top: 40px;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      max-width: 1200px;
      margin: 0 auto;
    }
  }
}
</file>

