  background: $yellow-100;
  color: $yellow-700;
}

.badge-published {
  @include badge-base;
  background: #dbeafe;
  color: #1d4ed8;
}

.badge-scheduled {
  @include badge-base;
  background: #ede9fe;
  color: #6d28d9;
}

.badge-failed {
  @include badge-base;
  background: $red-50;
  color: $red-600;
}

// ── Stat Card ────────────────────────────────────────────────
.stat-card {
  @include card;
  transition: border-color $transition-base, box-shadow $transition-base, transform $transition-base;

  @include hover-device {
    &:hover {
      border-color: $indigo-100;
      box-shadow: $shadow-card-hover;
