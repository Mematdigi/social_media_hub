// ============================================================
// _scheduler.scss — Scheduler (Calendar & List views)
// ============================================================
@use 'variables' as *;
@use 'mixins'    as *;

// ── Scheduler layout ─────────────────────────────────────────
.scheduler-calendar-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(1rem, 3vw, 1.5rem);

  @include lg { grid-template-columns: 2fr 1fr; }
}

// ── Calendar card ────────────────────────────────────────────
.calendar-card {
  @include card;
  overflow: hidden;

  // Override react-calendar styles for responsive fit
  .react-calendar {
    font-family: $font-body;
    border: none;
    width: 100%;
    font-size: $text-sm;

    &__navigation {
      button {
        font-size: $text-base;
        font-weight: 600;
        color: $slate-700;
        border-radius: $radius-md;
        min-height: 44px;

        @include hover-device {
          &:hover { background: $slate-100; }
        }
      }
    }

    &__month-view__weekdays__weekday {
      font-size: $text-xs;
      font-weight: 600;
      color: $slate-400;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: none;

      abbr { text-decoration: none; }
    }

    &__tile {
      font-size: $text-sm;
      border-radius: $radius-lg;
      min-height: 44px;     // touch-friendly tap target
      padding: 0.5rem 0.25rem;
      transition: background $transition-base;
      position: relative;

      @include hover-device {
        &:not(.react-calendar__tile--active):not(.react-calendar__tile--now):hover {
          background: $slate-100;
        }
      }

      &--now {
        background: $indigo-50;
        color: $indigo-700;
        font-weight: 700;
      }

      &--active {
        background: $indigo-500 !important;
        color: $white !important;
        border-radius: $radius-lg;
      }
    }
  }
}

// ── Calendar tile dots ───────────────────────────────────────
.calendar-tile-dots {
  display: flex;
  justify-content: center;
  gap: 2px;
  margin-top: 3px;

  &__dot {
    width: 6px;
    height: 6px;
    border-radius: $radius-full;

    &--published  { background: $green-500; }
    &--scheduled  { background: $blue-500; }
    &--draft      { background: $amber-500; }
  }

  &__more {
    font-size: 0.55rem;
    color: $slate-500;
    line-height: 1;
    align-self: center;
  }
}

// ── Selected date panel ──────────────────────────────────────
.selected-date-panel {
  @include card;
  @include scrollable;
  max-height: 600px;

  @include lg { max-height: none; }

  &__title {
    font-family: $font-heading;
    font-weight: 700;
    color: $slate-900;
    margin: 0 0 1rem;
    font-size: $text-lg;
  }

  &__empty {
    font-size: $text-sm;
    color: $slate-500;
    text-align: center;
    padding: 1.5rem 0;
  }

  &__posts {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
}

// ── Scheduled post item (in selected date panel) ─────────────
.scheduled-post-item {
  padding: clamp(0.75rem, 2vw, 1rem);
  border-radius: $radius-lg;
  background: $slate-50;
  border: 1px solid $slate-100;
  transition: border-color $transition-base;

  @include hover-device {
    &:hover { border-color: $indigo-100; }
  }

  &__content {
    font-size: $text-sm;
    color: $slate-700;
    margin: 0 0 0.625rem;
    @include line-clamp(2);
  }

  &__footer {
    @include flex-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  &__platforms {
    @include flex-start(0.25rem);
    flex-wrap: wrap;
  }

  &__actions {
    @include flex-start(0.375rem);
  }
}

// ── List view ────────────────────────────────────────────────
.scheduler-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;

  &__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;

    button {
      @include btn-base;
      padding: 0.4rem 0.875rem;
      border-radius: $radius-full;
      font-size: $text-sm;
      font-weight: 500;
      background: $slate-100;
      color: $slate-600;
      border: none;
      min-height: 36px;

      &.active {
        background: $indigo-50;
        color: $indigo-600;
      }

      @include hover-device {
        &:not(.active):hover { background: $slate-200; }
      }
    }
  }
}

// ── Scheduler table ──────────────────────────────────────────
.scheduler-table-wrap {
  @include card(0);
  overflow: hidden;

  &__scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;

    @include touch-device {
      scrollbar-width: none;
      &::-webkit-scrollbar { display: none; }
    }
  }

  table {
    min-width: 600px;
    width: 100%;
    border-collapse: collapse;

    thead {
      background: $slate-50;
      border-bottom: 1px solid $slate-100;

      th {
        text-align: left;
        padding: 1rem 1.25rem;
        font-size: $text-sm;
        font-weight: 600;
        color: $slate-600;
        white-space: nowrap;
      }
    }

    tbody tr {
      border-bottom: 1px solid $slate-100;
      transition: background $transition-fast;

      &:last-child { border-bottom: none; }

      @include hover-device {
        &:hover { background: $slate-50; }
      }

      td {
        padding: 0.875rem 1.25rem;
        font-size: $text-sm;
        color: $slate-700;
        vertical-align: middle;
      }
    }

    .content-cell {
      max-width: 220px;

      @include xl { max-width: 320px; }

      p { @include truncate; margin: 0; }
    }

    .platforms-cell {
      display: flex;
      gap: 0.25rem;
      align-items: center;
    }

    .actions-cell {
      display: flex;
      gap: 0.375rem;
      align-items: center;
      flex-wrap: wrap;
    }
  }
}

// ── Empty state for list view ─────────────────────────────────
.scheduler-empty {
  @include card;
  @include flex-center;
  flex-direction: column;
  gap: 0.75rem;
  padding: clamp(2rem, 6vw, 4rem);
  color: $slate-400;
  text-align: center;

  svg { opacity: 0.5; }

  p {
    font-size: $text-sm;
    margin: 0;
  }
}
</file>

