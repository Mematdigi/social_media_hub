// ============================================================
// _dashboard.scss — Dashboard page
// ============================================================
@use 'variables' as *;
@use 'mixins'    as *;

// ── Welcome header ───────────────────────────────────────────
.dashboard-welcome {
  margin-bottom: clamp(1.5rem, 4vw, 2.5rem);

  &__title {
    font-family: $font-heading;
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    font-weight: 700;
    color: $slate-900;
    margin: 0 0 0.375rem;
    line-height: 1.15;
  }

  &__subtitle {
    font-size: $text-lg;
    color: $slate-500;
    margin: 0;
  }
}

// ── Stats grid ───────────────────────────────────────────────
.dashboard-stats {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(0.75rem, 2vw, 1.25rem);
  margin-bottom: clamp(1.5rem, 4vw, 2.5rem);

  @include xs  { grid-template-columns: repeat(2, 1fr); }
  @include lg  { grid-template-columns: repeat(4, 1fr); }
}

// ── Recent Posts card ────────────────────────────────────────
.recent-posts-card {
  @include card(0);
  overflow: hidden;

  &__header {
    @include flex-between;
    padding: clamp(1rem, 3vw, 1.5rem);
    border-bottom: 1px solid $slate-100;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  &__header-left {
    @include flex-start(0.75rem);
  }

  &__header-icon {
    @include flex-center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: $radius-xl;
    background: $indigo-50;
    flex-shrink: 0;
    color: $indigo-600;
  }

  &__header-title {
    font-family: $font-heading;
    font-weight: 700;
    color: $slate-900;
    margin: 0;
    font-size: $text-base;
  }

  &__header-sub {
    font-size: $text-sm;
    color: $slate-500;
    margin: 0.125rem 0 0;
  }

  // Loading state
  &__loader {
    @include flex-center;
    padding: 2.5rem;

    &-spinner {
      width: 2rem;
      height: 2rem;
      border: 3px solid $slate-200;
      border-top-color: $indigo-500;
      border-radius: $radius-full;
      animation: spin 0.8s linear infinite;
    }
  }
}

// ── Recent post row ──────────────────────────────────────────
.post-row {
  display: flex;
  align-items: center;
  gap: clamp(0.75rem, 2vw, 1rem);
  padding: clamp(0.75rem, 2vw, 1rem) clamp(1rem, 3vw, 1.5rem);
  border-bottom: 1px solid $slate-100;
  transition: background $transition-fast;

  &:last-child { border-bottom: none; }

  @include hover-device {
    &:hover { background: $slate-50; }
  }

  &__content {
    flex: 1;
    min-width: 0;
  }

  &__text {
    font-size: $text-sm;
    font-weight: 500;
    color: $slate-900;
    @include truncate;
    margin: 0 0 0.25rem;
  }

  &__meta {
    @include flex-start(0.75rem);
    flex-wrap: wrap;
  }

  &__platforms {
    @include flex-start(0.25rem);
  }

  &__date {
    font-size: $text-xs;
    color: $slate-400;
  }

  &__more {
    font-size: $text-xs;
    color: $slate-500;
    margin-left: 0.25rem;
  }

  &__actions {
    @include flex-start(0.5rem);
    flex-shrink: 0;

    // On very small screens, hide edit button
    @include max-xs {
      display: none;
    }
  }
}
