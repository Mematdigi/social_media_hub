    &--disconnect {
      background: $slate-100;
      color: $slate-600;
      border: none;

      @include hover-device {
        &:hover { background: $red-50; color: $red-600; }
      }
    }
  }
}

// ── Connected indicator dot ───────────────────────────────────
.connected-dot {
