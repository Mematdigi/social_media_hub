// ── Auth Layout ──────────────────────────────────────────────
.auth-page {
  display: flex;
  min-height: 100vh;
  min-height: 100dvh;
  background: $slate-50;

  // ── Left panel (hero image) — desktop only ───────────────
  &__hero {
    display: none;
    position: relative;
    overflow: hidden;

    @include lg {
      display: flex;
      flex-direction: column;
      width: 50%;
      flex-shrink: 0;
    }

    img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &-overlay {
      position: absolute;
      inset: 0;
    }

    &-content {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: clamp(2rem, 5vw, 3rem);
      height: 100%;
