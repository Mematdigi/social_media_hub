<file path="frontend/src/assets/scss/_mixins.scss">
// ============================================================
// _mixins.scss — Reusable SCSS Mixins
// ============================================================
@use 'variables' as *;

// ── Flex helpers ─────────────────────────────────────────────
@mixin flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

@mixin flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

@mixin flex-start($gap: 0) {
  display: flex;
  align-items: center;
  @if $gap != 0 { gap: $gap; }
}

// ── Truncate text ────────────────────────────────────────────
@mixin truncate {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

@mixin line-clamp($lines: 2) {
  display: -webkit-box;
  -webkit-line-clamp: $lines;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

// ── Card base ────────────────────────────────────────────────
@mixin card($padding: $space-md) {
  background: $white;
  border-radius: $radius-2xl;
  border: 1px solid $slate-100;
  box-shadow: $shadow-card;
  padding: $padding;
}

// ── Gradient icon container ──────────────────────────────────
@mixin icon-box($from, $to, $size: 3.5rem, $radius: $radius-xl) {
  width: $size;
  height: $size;
  border-radius: $radius;
  background: linear-gradient(135deg, $from, $to);
  flex-shrink: 0;
  @include flex-center;
}

// ── Page header icon — responsive ───────────────────────────
@mixin page-icon {
  width: clamp(2.5rem, 6vw, 3.5rem);
  height: clamp(2.5rem, 6vw, 3.5rem);
  border-radius: $radius-xl;
  flex-shrink: 0;
  @include flex-center;
}

// ── Button base ──────────────────────────────────────────────
@mixin btn-base {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  text-decoration: none;
  white-space: nowrap;
  min-height: 44px; // WCAG tap target
  transition: transform $transition-base, box-shadow $transition-base, background-color $transition-base;
  -webkit-tap-highlight-color: transparent;

  &:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  &:active { transform: scale(0.97); }
}

// ── Input base ───────────────────────────────────────────────
@mixin input-base {
  width: 100%;
  height: 44px;
  padding: 0 1rem;
  border-radius: $radius-lg;
  border: 1.5px solid transparent;
  background: $slate-50;
  font-family: $font-body;
  font-size: 1rem;   // ≥16px prevents iOS auto-zoom
  font-weight: 500;
  color: $slate-700;
  transition: background-color $transition-base, border-color $transition-base, box-shadow $transition-base;
  -webkit-appearance: none;
  appearance: none;

  @include sm { height: 48px; }

  &:focus {
    outline: none;
    background: $white;
    border-color: $indigo-500;
    box-shadow: 0 0 0 4px rgba($indigo-500, 0.1);
  }

  &::placeholder { color: $slate-400; }
}

// ── Badge base ───────────────────────────────────────────────
@mixin badge-base {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.2rem 0.6rem;
  border-radius: $radius-full;
  font-size: $text-xs;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;

  @include md { padding: 0.25rem 0.75rem; }
}

// ── Glassmorphism ────────────────────────────────────────────
@mixin glass($opacity: 0.92) {
  background: rgba($white, $opacity);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

// ── Scrollable panel ─────────────────────────────────────────
@mixin scrollable {
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;

  // Hide scrollbar on touch devices
  @include touch-device {
    scrollbar-width: none;
    &::-webkit-scrollbar { display: none; }
  }

  @include hover-device {
    scrollbar-width: thin;
    scrollbar-color: $slate-300 $slate-100;

    &::-webkit-scrollbar { width: 6px; }
    &::-webkit-scrollbar-track { background: $slate-100; border-radius: 4px; }
    &::-webkit-scrollbar-thumb { background: $slate-300; border-radius: 4px; }
    &::-webkit-scrollbar-thumb:hover { background: $slate-400; }
  }
}

// ── Platform color utility generator ────────────────────────
@mixin platform-colors {
  @each $name, $color in $platforms {
    &-#{$name} { color: $color; }
  }
}

@mixin platform-bg-colors {
  @each $name, $color in $platforms {
    &-#{$name} { background-color: $color; }
  }
}

@mixin platform-border-colors {
  @each $name, $color in $platforms {
    &-#{$name} { border-color: $color; }
  }
}

// ── Skeleton loader ──────────────────────────────────────────
@mixin skeleton {
  border-radius: $radius-sm;
  background: linear-gradient(90deg, $slate-100 25%, $slate-200 50%, $slate-100 75%);
  background-size: 800px 100%;
  animation: shimmer 1.4s infinite linear;
}

// ── Safe area helpers ────────────────────────────────────────
@mixin safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
@mixin safe-top    { padding-top: env(safe-area-inset-top); }
@mixin safe-left   { padding-left: max(1rem, env(safe-area-inset-left)); }
@mixin safe-right  { padding-right: max(1rem, env(safe-area-inset-right)); }
</file>

