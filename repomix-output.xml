// ============================================================
// _posts.scss — Posts list, AddPost, EditPost
// ============================================================
@use 'variables' as *;
@use 'mixins'    as *;

// ── Posts list ───────────────────────────────────────────────
.posts-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

// ── Post card ────────────────────────────────────────────────
.post-card {
  @include card;
  transition: box-shadow $transition-base, border-color $transition-base;

  @include hover-device {
    &:hover {
      box-shadow: $shadow-card-hover;
      border-color: $indigo-100;
    }
  }

  &__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    @include sm {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  &__content {
    flex: 1;
    min-width: 0;
  }

  &__text {
    font-size: $text-sm;
    color: $slate-700;
    margin: 0 0 0.625rem;
    @include line-clamp(2);
  }

  &__meta {
    @include flex-start(0.75rem);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  &__platforms {
    @include flex-start(0.25rem);
    flex-wrap: wrap;
  }

  &__date {
    font-size: $text-xs;
    color: $slate-400;
  }

  &__actions {
    @include flex-start(0.5rem);
    flex-shrink: 0;
    flex-wrap: wrap;

    @include max-sm { width: 100%; }
  }

  // Image preview (if any)
  &__image {
    width: 100%;
    border-radius: $radius-lg;
    overflow: hidden;
    aspect-ratio: 16/9;

    @include sm {
      width: 6rem;
      flex-shrink: 0;
      aspect-ratio: 1;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
}

// ── Post Form (AddPost / EditPost) ───────────────────────────
.post-form-page {
  // Back button + header row
  &__header {
    @include flex-start(clamp(0.75rem, 2vw, 1rem));
    margin-bottom: clamp(1.5rem, 4vw, 2rem);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  &__title-group {
    @include flex-start(clamp(0.75rem, 2vw, 1rem));
  }

  &__icon {
    @include page-icon;
  }

  &__title {
    font-family: $font-heading;
    font-size: $text-3xl;
    font-weight: 700;
    color: $slate-900;
    margin: 0;
  }

  &__subtitle {
    font-size: $text-sm;
    color: $slate-500;
    margin: 0.125rem 0 0;
  }

  // The card containing PostForm
  &__card {
    @include card;
    padding: clamp(1.25rem, 4vw, 2rem);
    max-width: 42rem;         // ~2xl
    width: 100%;
  }
}

// ── Post Form fields ─────────────────────────────────────────
.post-form {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;

  &__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  &__label {
    font-size: $text-sm;
    font-weight: 600;
    color: $slate-700;
  }

  // Platform selector grid
  &__platforms {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 120px), 1fr));
    gap: 0.625rem;
  }

  &__platform-btn {
    @include flex-start(0.5rem);
    padding: 0.5rem 0.75rem;
    border-radius: $radius-lg;
    border: 1.5px solid $slate-200;
    background: $white;
    cursor: pointer;
    font-size: $text-sm;
    font-weight: 500;
    color: $slate-600;
    transition: border-color $transition-base, background $transition-base;
    min-height: 44px;

    &.selected {
      border-color: $indigo-500;
      background: $indigo-50;
      color: $indigo-600;
    }

    @include hover-device {
      &:hover:not(.selected) { background: $slate-50; border-color: $slate-300; }
    }
  }

  // Scheduled date row
  &__schedule-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    @include sm {
      flex-direction: row;
      align-items: center;
    }
  }

  &__submit-row {
    @include flex-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid $slate-100;

    &-actions {
      @include flex-start(0.75rem);
      flex-wrap: wrap;
    }
  }
}

// ── Not Found state (EditPost) ───────────────────────────────
.post-not-found {
  @include card;
  text-align: center;
  padding: clamp(2rem, 6vw, 3.5rem);
  max-width: 28rem;
  margin: 0 auto;

  &__title {
    font-family: $font-heading;
    font-size: $text-2xl;
    font-weight: 700;
    color: $slate-900;
    margin: 0 0 0.75rem;
  }

  &__desc {
    font-size: $text-sm;
    color: $slate-500;
    margin: 0 0 1.5rem;
  }
}
