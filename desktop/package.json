{
  "name": "socialhub-desktop",
  "productName": "SocialHub",
  "version": "1.0.0",
  "description": "SocialHub desktop app — the social media dashboard for Windows, macOS and Linux",
  "main": "main.js",
  "author": "Memat Digi",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "start": "electron .",
    "start:remote": "electron . --remote",
    "dev": "electron . --dev",
    "dist": "npm run build:web && electron-builder",
    "dist:win": "npm run build:web && electron-builder --win",
    "dist:mac": "npm run build:web && electron-builder --mac",
    "dist:linux": "npm run build:web && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mematdigi.socialhub",
    "productName": "SocialHub",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["main.js", "preload.js", "config.json", "offline.html", "assets/**", "web-build/**"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "SocialHub" },
    "mac": { "target": ["dmg"], "category": "public.app-category.social-networking", "icon": "assets/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "Network", "icon": "assets/icon.png", "maintainer": "Memat Digi" }
  }
}
